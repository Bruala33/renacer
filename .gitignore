# Python & Bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
.pytest_cache/
.coverage
htmlcov/

# Node
node_modules/

# Environment & Credentials
.env
.env.*
!.env.example

# Caches, Legacy Backups & Temporary Storage
gdrive_cache/
app/gdrive_cache/
app/Beatstar_ai-main/
/downloads/
/public/
.cache/
scratch/

# Archives & Compressed Files
*.zip
*.7z
*.rar
dist_itch/
*.tar
*.gz
*.osz
*.sng

# Audio & Media Dumps (except tracked game assets below)
*.wav
*.mp3
*.webm
*.m4a
*.ogg
*.flac

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Agent & OS / Editor
.gemini/
.DS_Store
Thumbs.db
.vscode/
.idea/
*.iml

# Android Build & Gradle Cache (root & android/)
.gradle/
**/.gradle/
.kotlin/
build/
app/build/
android/build/
android/app/build/
captures/
android/captures/
.externalNativeBuild/
.cxx/
local.properties
**/local.properties

# Signing Keys: keep unified sideload key in repo so PC & AI Studio never conflict
*.aab
*.keystore
*.jks
!app-signing.keystore

# Ignore intermediate APKs, allow official downloadable PianoCommunity.apk
*.apk
*.idsig
!PianoCommunity.apk
!app/static/PianoCommunity.apk
!app/static/downloads/*.apk

# Misc local tools / dumps
cookies.txt
**/cookies.txt
cloudflared.exe
*.exe
love_man.bin
*.bin

# Allow community DB & bundled game audio assets in Git
!app/data/
!app/data/**
!app/data/community/community_backup.json
!app/uploads/
!app/uploads/**
!app/uploads/community/**
!app/uploads/community/**/*.mp3
!app/uploads/community/**/*.ogg
!app/uploads/community/**/*.wav
!app/static/songs/
!app/static/songs/**
!app/static/songs/**/*.mp3
!app/static/songs/**/*.json
!app/static/assets/
!app/static/assets/**
!app/static/assets/*.mp3
!app/src/main/assets/www/assets/*.mp3
!android/app/src/main/assets/www/assets/*.mp3
!app/src/main/assets/www/songs/**/*.mp3
!android/app/src/main/assets/www/songs/**/*.mp3
